
<div class="flex flex-col space-y-4">
  <a href="/search">Search Notes</a>

  <!-- Filtering-->
  <div :if={@all !=[] or @any !=[] or @none !=[]} class="flex flex-wrap gap-2 items-center">
    <h1>Filtering:</h1>
    <a 
      :for={tag <- @all}
      href={~p"/pages?#{filter_without(@all, @any, @none, :all, tag)}"}
      class="text-xs px-2 py-1 rounded bg-emereald-100 hover:bg-emerald-200 no-underline"
      title="Click to remote from 'all'"
    >all: {tag} ×</a>

    <a 
      :for={tag <- @any}
      href={~p"/pages?#{filter_without(@all, @any, @none, :any, tag)}"}
      class="text-xs px-2 py-1 rounded bg-emereald-100 hover:bg-emerald-200 no-underline"
      title="click to remote from 'any'"
    >any: {tag} ×</a>

    <a 
      :for={tag <- @none}
      href={~p"/pages?#{filter_without(@all, @any, @none, :none, tag)}"}
      class="text-xs px-2 py-1 rounded bg-emereald-100 hover:bg-emerald-200 no-underline"
      title="click to remote from 'none'"
    >none: {tag} ×</a>

  </div>


  <!-- List -->
  <div>
    <h1>List</h1>
    <ul :if={@names != []}>
      <li :for={name <- @names}>
        <a href={~p"/pages/#{name}"}>{name}</a>
        <span :for={tag <- YasushisakaiCom.Markdown.tags(name)} class="ml-2">
         <a 
           href={~p"/pages?#{[all: tag]}"}
           class="text-xs px-1.5 py-0.5 rounded bg-base-200 hover:bg-base-300 no-underline"
        >{tag}</a>
        </span>
      </li>
    </ul>
    <p :if={@names == []}>No notes match.</p>
  </div>
</div>
