  <div>
    <b>tags</b>
    <ul :if={@counts != []} class="list-none p-0 grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1 items-baseline">
      <li :for={{tag, count} <- @counts} class="my-1">
        <a href={~p"/pages?#{[all: tag]}"}>{tag}</a>
        <span class="text-slate-500 text-sm">({count})</span>
      </li>
    </ul>
    <p :if={@counts == []} class="text-slate-500">No tags yet.</p>
  </div>
